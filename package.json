{
  "name": "champions-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:dev": "node scripts/build-sites-environment.mjs dev",
    "build:production": "node scripts/build-sites-environment.mjs production",
    "start": "vinext start",
    "test": "vitest run && pnpm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "data:audit": "node scripts/audit-form-integrity.mjs",
    "data:audit:live": "node scripts/audit-form-integrity.mjs --live",
    "verify:deploy": "pnpm run lint && pnpm run typecheck && pnpm run data:audit && pnpm test",
    "verify:dev": "pnpm verify:deploy && pnpm build:dev && node scripts/assert-sites-build.mjs dev",
    "db:generate": "drizzle-kit generate",
    "data:sync": "node scripts/sync-upstream.mjs",
    "data:sync:items": "node scripts/sync-upstream.mjs --items-only"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "drizzle-orm": "0.45.2",
    "idb-keyval": "^6.3.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
